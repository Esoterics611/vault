# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digitalvault_pre
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Blockchain Configuration (Base Sepolia)
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
CONTENT_REGISTRY_ADDRESS=0xd469e2AA709bb01ab409eBb762c655FC641C41f0
REKEY_REGISTRY_ADDRESS=0xBC835256b0D08DFeD09c7cE3B07eD945C6e243aA

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100   # max requests per window
RATE_LIMIT_REENCRYPT_MAX=50   # max re-encryptions per window

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:3000

# Security
MAX_CAPSULE_SIZE=1048576  # 1MB max capsule size
