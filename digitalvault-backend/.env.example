# DigitalVault Backend - Environment Configuration
# Week 11 - Complete Stack Integration
# Copy this file to .env and configure with your actual values

# ================================================
# BLOCKCHAIN CONFIGURATION
# ================================================

# Base Sepolia Testnet (default)
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# For local development (Hardhat/Ganache)
# RPC_URL=http://localhost:8545
# CHAIN_ID=31337

# ================================================
# SMART CONTRACT ADDRESSES (Week 7 Deployment)
# ================================================

# Content Registry Contract
CONTENT_REGISTRY_ADDRESS=0xd469e2AA709bb01ab409eBb762c655FC641C41f0

# Rekey Registry Contract (PRE)
REKEY_REGISTRY_ADDRESS=0xBC835256b0D08DFeD09c7cE3B07eD945C6e243aA

# DAO Governance Contract
DAO_CONTRACT_ADDRESS=your_dao_contract_address_here

# VaultToken Contract
VAULT_TOKEN_ADDRESS=0x9583d1643354B9C254586966343D54bCB79970D3

# ================================================
# DATABASE PASSWORDS
# ================================================

# PRE Proxy Database (Week 8-9)
PRE_DB_PASSWORD=your_secure_password_here

# DAO Service Database (Week 9)
DAO_DB_PASSWORD=your_secure_password_here

# IPFS Gateway Database (Week 10)
IPFS_DB_PASSWORD=your_secure_password_here

# Legacy Services Database
LEGACY_DB_PASSWORD=your_secure_password_here

# ================================================
# IPFS / PINATA CONFIGURATION (Week 10)
# ================================================

# Pinata API Credentials (get from https://pinata.cloud)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# OR use JWT (recommended for production)
PINATA_JWT=your_pinata_jwt_token_here

# Pinata Gateway (default)
PINATA_GATEWAY=https://gateway.pinata.cloud

# ================================================
# SERVICE CONFIGURATION
# ================================================

# PRE Proxy Service (Port 3001)
PRE_PORT=3001
PRE_LOG_LEVEL=info

# DAO Service (Port 3002)
DAO_PORT=3002
DAO_LOG_LEVEL=info

# IPFS Gateway (Port 3000)
IPFS_PORT=3000
IPFS_LOG_LEVEL=info
IPFS_MAX_FILE_SIZE=104857600
IPFS_RATE_LIMIT_UPLOAD_MAX=20

# ================================================
# CORS CONFIGURATION
# ================================================

# Allow all origins (development)
CORS_ORIGIN=*

# Production: specify frontend domain
# CORS_ORIGIN=https://digitalvault.app

# ================================================
# OPTIONAL: FIREBASE (Notification Service)
# ================================================

FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# ================================================
# NOTES
# ================================================
# 1. Replace all "your_*_here" placeholders with actual values
# 2. Keep this file secure - never commit .env to git
# 3. Each service has its own PostgreSQL database for isolation
# 4. All services communicate via digitalvault-network
# 5. Production services run by default, legacy services need --profile legacy
